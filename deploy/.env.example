# ChatBox environment example.
#
# Copy to deploy/.env and edit for your machine:
#   cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------

# MySQL shards. Semicolon-separated shard specs; within a shard, pipe-separated
# hosts where the first is the primary and the rest are read replicas. Leave
# unset to run the in-memory backend (development/tests only; data is not
# persisted).
#
#   one shard, two replicas:
#     MYSQL_SHARDS=mysql://chatbox:chatbox@127.0.0.1:3306/chatbox|mysql://chatbox:chatbox@127.0.0.1:3307/chatbox|mysql://chatbox:chatbox@127.0.0.1:3308/chatbox
#   two shards, first with a replica:
#     MYSQL_SHARDS=mysql://chatbox:chatbox@127.0.0.1:3306/chatbox0|mysql://chatbox:chatbox@127.0.0.1:3307/chatbox0;mysql://chatbox:chatbox@127.0.0.1:3306/chatbox1
MYSQL_SHARDS=mysql://chatbox:chatbox@127.0.0.1:3306/chatbox

# Redis. Use REDIS_URL for a single node, or REDIS_CLUSTER_NODES (comma-
# separated seed URLs) for a cluster. Cluster nodes take precedence. Set
# REDIS_ENABLED=false to use in-process adapters.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_CLUSTER_NODES=redis://127.0.0.1:7000,redis://127.0.0.1:7001,redis://127.0.0.1:7002
REDIS_ENABLED=true

# ---------------------------------------------------------------------------
# HTTP and auth
# ---------------------------------------------------------------------------

HTTP_BIND=0.0.0.0:8080
# Secret used to sign access tokens. Generate a strong random value.
JWT_SECRET=change-me-in-production
# Public base URL used to build local pre-signed upload URLs.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Node and scaling
# ---------------------------------------------------------------------------

# Stable identifier for this node (used in the connection registry).
NODE_ID=node-1
# Snowflake node number (0..1023); must be unique per node.
NODE_NUMBER=1
# Groups at or below this size fan out on write; larger groups fan out on read.
FANOUT_WRITE_MAX_MEMBERS=256

# ---------------------------------------------------------------------------
# Plugins and object storage
# ---------------------------------------------------------------------------

# Directory scanned for server plugin manifests.
PLUGIN_DIR=plugins
# Deadline for one server-plugin hook call, in milliseconds (0 disables it).
PLUGIN_HOOK_TIMEOUT_MS=500
# Directory backing local object storage (development).
OBJECT_STORAGE_DIR=data/objects
# Comma-separated blocked words enforced by the built-in message guard.
MESSAGE_GUARD_WORDS=
# Comma-separated custom user ids allowed to manage server plugins.
# When empty, any authenticated user may manage them (development default).
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

RUST_LOG=info
