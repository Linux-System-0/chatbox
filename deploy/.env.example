# ChatBox environment example.
#
# Copy to deploy/.env and edit for your machine:
#   cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------

# MySQL primary connection string. Leave unset to run the in-memory backend
# (development/tests only; data is not persisted).
DATABASE_URL=mysql://chatbox:chatbox@127.0.0.1:3306/chatbox
# Optional MySQL read replica.
# DATABASE_REPLICA_URL=mysql://chatbox:chatbox@127.0.0.1:3307/chatbox

# Redis connection string. Set REDIS_ENABLED=false to use in-process adapters.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# ---------------------------------------------------------------------------
# HTTP and auth
# ---------------------------------------------------------------------------

HTTP_BIND=0.0.0.0:8080
# Secret used to sign access tokens. Generate a strong random value.
JWT_SECRET=change-me-in-production
# Public base URL used to build local pre-signed upload URLs.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Node and scaling
# ---------------------------------------------------------------------------

# Stable identifier for this node (used in the connection registry).
NODE_ID=node-1
# Snowflake node number (0..1023); must be unique per node.
NODE_NUMBER=1
# Groups at or below this size fan out on write; larger groups fan out on read.
FANOUT_WRITE_MAX_MEMBERS=256

# ---------------------------------------------------------------------------
# Plugins and object storage
# ---------------------------------------------------------------------------

# Directory scanned for server plugin manifests.
PLUGIN_DIR=plugins
# Directory backing local object storage (development).
OBJECT_STORAGE_DIR=data/objects
# Comma-separated blocked words enforced by the built-in message guard.
MESSAGE_GUARD_WORDS=
# Comma-separated custom user ids allowed to manage server plugins.
# When empty, any authenticated user may manage them (development default).
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

RUST_LOG=info
